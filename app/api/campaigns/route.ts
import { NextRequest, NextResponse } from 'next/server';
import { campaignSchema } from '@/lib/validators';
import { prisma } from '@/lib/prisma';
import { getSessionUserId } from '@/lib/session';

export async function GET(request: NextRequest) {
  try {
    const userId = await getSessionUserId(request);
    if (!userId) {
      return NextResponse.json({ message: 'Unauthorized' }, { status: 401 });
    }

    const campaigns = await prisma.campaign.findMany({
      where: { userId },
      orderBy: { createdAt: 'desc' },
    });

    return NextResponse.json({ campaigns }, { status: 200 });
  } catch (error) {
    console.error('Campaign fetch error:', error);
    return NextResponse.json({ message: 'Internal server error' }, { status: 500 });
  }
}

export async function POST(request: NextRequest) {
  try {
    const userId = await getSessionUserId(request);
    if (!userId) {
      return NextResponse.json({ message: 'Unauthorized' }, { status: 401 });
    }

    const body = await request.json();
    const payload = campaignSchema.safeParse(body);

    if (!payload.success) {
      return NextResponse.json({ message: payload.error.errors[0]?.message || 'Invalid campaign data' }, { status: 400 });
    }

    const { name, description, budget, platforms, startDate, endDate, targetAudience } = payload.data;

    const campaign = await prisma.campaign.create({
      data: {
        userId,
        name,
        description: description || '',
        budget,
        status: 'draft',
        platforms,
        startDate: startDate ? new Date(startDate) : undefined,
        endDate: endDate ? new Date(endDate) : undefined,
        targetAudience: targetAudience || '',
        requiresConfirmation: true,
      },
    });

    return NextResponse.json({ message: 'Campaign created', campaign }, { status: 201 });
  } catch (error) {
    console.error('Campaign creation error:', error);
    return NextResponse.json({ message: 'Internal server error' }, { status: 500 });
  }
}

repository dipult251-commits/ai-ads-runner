import { NextRequest, NextResponse } from 'next/server';
import { generatePosterPrompt, posterSchema } from '@/lib/validators';
import { prisma } from '@/lib/prisma';
import { getSessionUserId } from '@/lib/session';

export async function POST(request: NextRequest) {
  try {
    const body = await request.json();
    const payload = posterSchema.safeParse(body);

    if (!payload.success) {
      return NextResponse.json({ message: payload.error.errors[0]?.message || 'Invalid input' }, { status: 400 });
    }

    const { title, theme, layout } = payload.data;
    const prompt = await generatePosterPrompt({ title, theme, layout });

    const userId = await getSessionUserId(request);
    if (userId) {
      await prisma.poster.create({
        data: {
          userId,
          title,
          theme,
          layout,
          prompt,
        },
      });
    }

    return NextResponse.json({ message: 'Poster concept generated', prompt, title, theme, layout }, { status: 200 });
  } catch (error) {
    console.error('Poster generation error:', error);
    return NextResponse.json({ message: 'Internal server error' }, { status: 500 });
  }
}
